{
  "name": "codejar",
  "version": "4.3.0",
  "description": "An embeddable code editor for the browser",
  "type": "module",
  "main": "./dist/codejar.js",
  "module": "./dist/codejar.js",
  "types": "./dist/codejar.d.ts",
  "exports": {
    ".": {
      "types": "./dist/codejar.d.ts",
      "import": "./dist/codejar.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --mode demo",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:workflow": "uvx zizmor@1.32.0 .github/workflows -v -p --min-severity=medium",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@vitest/browser-playwright": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "prismjs": "^1.30.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "editor",
    "code-editor",
    "contenteditable",
    "syntax-highlighting",
    "prism",
    "highlight.js"
  ],
  "homepage": "https://medv.io/codejar/",
  "bugs": {
    "url": "https://github.com/antonmedv/codejar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonmedv/codejar.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "author": "Anton Medvedev <anton@medv.io>"
}
